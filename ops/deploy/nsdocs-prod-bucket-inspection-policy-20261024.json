{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadFiscalProdSafetyConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::fluxy-fiscal-prod",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringEquals": {
          "s3:ResourceAccount": "992500432025"
        }
      }
    }
  ]
}
