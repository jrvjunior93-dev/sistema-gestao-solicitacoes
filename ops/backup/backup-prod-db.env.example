# Instalar em /etc/fluxy/backup-prod-db.env (permissoes 0600).
# Nao colocar credenciais, tokens ou valores reais no repositorio.
BACKUP_DB_NAME=SUBSTITUIR_PELO_BANCO_DE_PRODUCAO
BACKUP_MYSQL_DEFAULTS_FILE=/etc/fluxy/mysql-backup.cnf
BACKUP_RCLONE_CONFIG=/etc/fluxy/rclone.conf
BACKUP_RCLONE_REMOTE=fluxy-crypt:producao/mysql
BACKUP_WORK_DIR=/var/lib/fluxy-backup/mysql
