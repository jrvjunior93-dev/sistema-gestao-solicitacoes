{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "FiscalProdBucketLocation", "Effect": "Allow", "Action": "s3:GetBucketLocation", "Resource": "arn:aws:s3:::fluxy-fiscal-prod" },
    { "Sid": "FiscalProdListPrefix", "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::fluxy-fiscal-prod", "Condition": { "StringLike": { "s3:prefix": ["prod/", "prod/*"] } } },
    { "Sid": "FiscalProdObjects", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:GetObjectVersion"], "Resource": "arn:aws:s3:::fluxy-fiscal-prod/prod/*" }
  ]
}
