# =============================================================================
# FLUXY BACKEND — CONFIGURAÇÃO DE AMBIENTE
# Preencha os campos em branco antes de subir para produção.
# =============================================================================


# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# Troca rápida de usuário para QA. As duas variáveis são obrigatórias e o
# backend recusa o recurso quando DEPLOYMENT_ENV não for dev/development.
# Nunca habilite em produção.
DEPLOYMENT_ENV=
DEV_USER_SWITCH_ENABLED=false


# ── Banco de dados (MySQL) ────────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Exclusivo de DEV/QA. Nao configure em producao. O script
# scripts/valida-pendencias.js exige que estes valores coincidam exatamente
# com DB_HOST e DB_NAME, alem de ALLOW_DEV_TEST_WRITES=true no comando atual.
DEV_TEST_ALLOWED_DB_HOST=
DEV_TEST_ALLOWED_DB_NAME=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000
TRUST_PROXY=1
REQUEST_BODY_LIMIT_MB=2

# Observabilidade do modulo de Compras. Desligada por padrao.
# Quando ativa, registra somente metricas agregadas; nao registra SQL nem dados enviados.
COMPRAS_PERFORMANCE_ENABLED=false
COMPRAS_PERFORMANCE_SAMPLE_RATE=1
COMPRAS_PERFORMANCE_SLOW_QUERY_MS=250


# ── Domínio e URLs ────────────────────────────────────────────────────────────
APP_DOMAIN=
FRONTEND_URL=
FRONTEND_PUBLIC_URL=
APP_FRONTEND_URL=

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=


# ── Identidade da aplicação ───────────────────────────────────────────────────
PRODUCT_NAME=
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_LOGO_URL=


# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h


# ── Cookies de autenticação ───────────────────────────────────────────────────
AUTH_COOKIE_NAME=fluxy_auth
AUTH_COOKIE_SAME_SITE=lax
# Em produção com HTTPS deve ser true
AUTH_COOKIE_SECURE=true
# Deixe em branco para usar o domínio padrão, ou informe ex: .seudominio.com.br
AUTH_COOKIE_DOMAIN=


# ── CSRF ──────────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=fluxy_csrf
CSRF_HEADER_NAME=X-CSRF-Token


# ── MFA ───────────────────────────────────────────────────────────────────────
# Aparece no aplicativo autenticador (ex: Google Authenticator)
MFA_ISSUER=
MFA_CHALLENGE_EXPIRES_IN=5m
# 32 bytes em hexadecimal (64 caracteres) ou base64. Nao reutilizar JWT_SECRET.
MFA_ENCRYPTION_KEY=


# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=5
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=30
CRITICAL_RATE_LIMIT_WINDOW_MINUTES=1
CRITICAL_RATE_LIMIT_MAX_ATTEMPTS=60
PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5


# ── Uploads e importações ─────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=50
CSV_IMPORT_MAX_ROWS=5000


# ── AWS S3 (armazenamento de arquivos) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=


# ── Redis / Valkey (cache e filas) ────────────────────────────────────────────
REDIS_URL=
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=fluxy:


# ── ClamAV (antivírus — opcional) ────────────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_FAIL_CLOSED=false
CLAMAV_REQUIRED=false


# ── Logs de segurança ─────────────────────────────────────────────────────────
SECURITY_LOG_RETENTION_DAYS=90


# ── Geração de PDF (Puppeteer/Chrome) ─────────────────────────────────────────
# Descomente e informe o caminho do Chrome instalado no servidor, se necessário
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable


# ── CRM — Automações ──────────────────────────────────────────────────────────
CRM_AUTOMATION_ENABLED=true
CRM_AUTOMATION_INTERVAL_SECONDS=60
CRM_AUTOMATION_STARTUP_DELAY_MS=15000
CRM_AUTOMATION_BATCH_SIZE=100

# Core Gateway - FLUXY Experience
CORE_GATEWAY_ENABLED=false
CORE_GATEWAY_CLIENT_ID=
CORE_GATEWAY_CLIENT_SECRET=
CORE_GATEWAY_ALLOWED_ORIGINS=
CORE_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
CORE_GATEWAY_RATE_LIMIT_MAX=120
CORE_GATEWAY_SIGNATURE_TOLERANCE_MS=300000

# Fallbacks opcionais para Meta Lead Ads. Preferir configurar pelo painel CRM.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v20.0
META_PAGE_ID=

# Nota: as integrações com Meta (Facebook Lead Ads) e Google Ads são
# configuradas pelo painel da aplicação após o deploy (ficam no banco de dados).


# ── Boletos Caixa Econômica (SIGCB) ──────────────────────────────────────────
# Necessário homologar amostras com a Caixa antes de emitir em produção.
# Mude CAIXA_BOLETO_AMBIENTE para PRODUCAO somente após homologação aprovada.
CAIXA_BOLETO_AMBIENTE=TESTE
CAIXA_BOLETO_HOMOLOGADO=false
CAIXA_AGENCIA=
CAIXA_CODIGO_BENEFICIARIO=
CAIXA_BENEFICIARIO_NOME=
CAIXA_BENEFICIARIO_CPF_CNPJ=
CAIXA_BENEFICIARIO_ENDERECO=
CAIXA_LOCAL_PAGAMENTO=EM TODA A REDE BANCARIA E SEUS CORRESPONDENTES ATE O VALOR LIMITE
CAIXA_BOLETO_INSTRUCAO=


# Banco do Brasil - Pagamentos em Lote
BB_PAYMENTS_ENABLED=true
BB_PAYMENTS_PROVIDER=BB
BB_PAYMENTS_ENV=production
BB_PROVIDER_MODE=real

# URLs BB
# Producao: https://pagamentos-lote.mtls.api.bb.com.br/v1
# Homologacao: https://pagamentos-lote.mtls.api.hm.bb.com.br/v1
BB_PAYMENTS_BASE_URL=https://pagamentos-lote.mtls.api.bb.com.br/v1
BB_OAUTH_TOKEN_URL=https://oauth.bb.com.br/oauth/token

# Credenciais OAuth/App - preencher manualmente fora do repositorio
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=

# Certificado A1 / mTLS - preencher manualmente fora do repositorio
BB_CERT_TYPE=pfx
BB_CERT_PATH=
BB_CERT_PASSPHRASE=
BB_CA_CERT_PATH=
# Obrigatoriamente true para qualquer envio real ao BB.
BB_TLS_REJECT_UNAUTHORIZED=true

# Conta/convenio pagador - preencher conforme convenio BB
BB_NUMERO_CONTRATO_PAGAMENTO=
BB_AGENCIA_DEBITO=
BB_CONTA_CORRENTE_DEBITO=
BB_DIGITO_CONTA_CORRENTE_DEBITO=
BB_CNPJ_PAGADOR=

# ── FLUXY Experience Sync ─────────────────────────────────────────────────────
# Usado pelo FLUXY Experience para sincronizar empreendimentos via:
# GET /api/experience-sync/empreendimentos
# Header: X-Experience-Sync-Key
EXPERIENCE_SYNC_KEY=
BB_REQUEST_TIMEOUT_MS=30000
BB_TOKEN_CACHE_TTL_SECONDS=3000
BB_OAUTH_MAX_ATTEMPTS=3
BB_REAL_PROVIDER_ENABLED=false
# Legado: manter apenas para ambientes antigos que ainda usam o nome sandbox.
BB_SANDBOX_REAL_ENABLED=false

# Webhook BB
BB_WEBHOOK_ENABLED=false
BB_WEBHOOK_PATH=/api/payments/bb/webhook
BB_WEBHOOK_REQUIRE_MTLS=true
BB_WEBHOOK_SECRET=
BB_WEBHOOK_SECRET_HEADER=x-fluxy-bb-webhook-secret
# O proxy reverso deve remover qualquer valor recebido do cliente e sobrescrever
# este header somente quando a verificacao do certificado cliente for bem-sucedida.
BB_WEBHOOK_MTLS_VERIFIED_HEADER=x-fluxy-client-cert-verified
BB_WEBHOOK_MTLS_VERIFIED_VALUE=SUCCESS


# ── D4Sign (assinatura digital — opcional) ────────────────────────────────────
D4SIGN_BASE_URL=https://secure.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=
D4SIGN_CRYPT_KEY=
D4SIGN_SAFE_UUID=
# URL pública onde o D4Sign enviará notificações (ex: https://api.seudominio.com.br/webhooks/d4sign)
D4SIGN_WEBHOOK_URL=
D4SIGN_WEBHOOK_SECRET=
D4SIGN_SKIP_EMAIL=false
D4SIGN_WORKFLOW=

# Modulo Fiscal - fundacao DEV
FISCAL_MODULE_ENABLED=false
FISCAL_SEFAZ_ENABLED=false
FISCAL_ENV=dev
FISCAL_S3_BUCKET=
FISCAL_S3_REGION=sa-east-1
FISCAL_S3_PREFIX=dev
FISCAL_S3_PRESIGNED_EXPIRES_SECONDS=300
FISCAL_CRYPTO_KEY=
FISCAL_SEFAZ_LOCK_TTL_SECONDS=900
# Homologacao oficial Ambiente Nacional: https://hom1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
# Producao oficial Ambiente Nacional: https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
FISCAL_SEFAZ_DFE_DISTRIBUTION_URL=
FISCAL_SEFAZ_REQUEST_TIMEOUT_MS=30000
FISCAL_SEFAZ_EMPTY_RESULT_WAIT_MINUTES=60
FISCAL_SEFAZ_CONSUMO_INDEVIDO_WAIT_MINUTES=60
